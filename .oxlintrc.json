{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc", "react"],
	"categories": {
		"correctness": "error"
	},
	"env": {
		"builtin": true,
		"browser": true,
		"node": true,
		"es2024": true
	},
	"rules": {
		"react/set-state-in-effect": "off"
	}
}
